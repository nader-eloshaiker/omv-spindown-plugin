set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
    configure)
        # Activate package triggers.
        dpkg-trigger update-workbench

        # Salt notices changed states by modification time, and dpkg stamps
        # files with the changelog date, so a rebuilt package of the same
        # version would keep using salt's cached copy. Refresh the times.
        touch /srv/salt/omv/deploy/spindown/*.sls \
            /srv/salt/omv/deploy/spindown/files/* || :
        # Start watching the disks that already have a spindown time.
        omv-salt deploy run --no-color --quiet spindown || :
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

# Pick up a new daemon and unit file after an upgrade. dh_installsystemd
# --no-start does not reload systemd, so do it here before restarting.
if [ "$1" = "configure" ] && [ -n "$2" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || :
    fi
    deb-systemd-invoke try-restart spindownd.service || :
fi

exit 0
